# Zorunlu: Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Zorunlu: yönetim paneli
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-14-characters
ADMIN_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
RATE_LIMIT_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters

# Ustaya yeni randevu için CallMeBot WhatsApp bildirimi
CALLMEBOT_PHONE=905xxxxxxxxx
CALLMEBOT_API_KEY=replace-with-callmebot-key

# Müşteriye randevu ve durum güncellemesi için Resend e-postası
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Çiçek Oto <randevu@bildirim.example.com>
# Yanıtların ulaşacağı adres; boş bırakılabilir.
RESEND_REPLY_TO=servis@example.com

# İsteğe bağlı: canlı Google puanı ve Google API'nin döndürdüğü en fazla 5 yorum
GOOGLE_PLACES_API_KEY=replace-with-google-places-key
# Opsiyonel; boş bırakılırsa Çiçek Otomotiv'in doğrulanmış Place ID'si kullanılır.
GOOGLE_PLACE_ID=ChIJKZIl83-vyhQR8y5m3bAz9Ug
