# Zorunlu: Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Zorunlu: yönetim paneli
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-14-characters
ADMIN_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
RATE_LIMIT_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters

# İsteğe bağlı: işletme sahibine CallMeBot bildirimi
CALLMEBOT_PHONE=905xxxxxxxxx
CALLMEBOT_API_KEY=replace-with-callmebot-key

# İsteğe bağlı: müşteriye resmi WhatsApp Cloud API bildirimi
WHATSAPP_ACCESS_TOKEN=replace-with-meta-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=tr
WHATSAPP_TEMPLATE_RECEIVED=appointment_received
WHATSAPP_TEMPLATE_CONFIRMED=appointment_confirmed
WHATSAPP_TEMPLATE_RESCHEDULED=appointment_rescheduled
WHATSAPP_TEMPLATE_CANCELLED=appointment_cancelled

# İsteğe bağlı: canlı Google puanı ve en fazla 5 yorum
GOOGLE_PLACES_API_KEY=replace-with-google-places-key
GOOGLE_PLACE_ID=replace-with-place-id
